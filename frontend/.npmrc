# Beyonder frontend npmrc — defense in depth
# All values redundant with docker-compose env, but belt and braces.

# Block postinstall and preinstall scripts — the #1 npm malware vector.
ignore-scripts=true

# Force exact versions on any future "pnpm add"
save-exact=true

# Demand a working lockfile in CI/Docker
frozen-lockfile=true

# Don't phone home
fund=false

# Audit on install
audit=true

# No telemetry to npm/pnpm
update-notifier=false

# Reject installs that require >X minutes of unaudited transitive code
# (Soft enforcement — manual gate during deps bumps.)

# pnpm-specific
prefer-frozen-lockfile=true
