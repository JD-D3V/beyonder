# Beyonder env vars — copy to .env, never commit.

# Gemini (Google AI Studio — free tier, no card)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Qdrant (local docker by default; cloud free tier optional)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=beyonder_chunks

# Postgres (local docker by default; Supabase free tier optional)
# Local: postgresql://beyonder:beyonder@localhost:5433/beyonder
# Supabase: postgresql://postgres:PASS@db.PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://beyonder:beyonder@localhost:5433/beyonder

# Spoiler control default (chapters considered "read") — per-user override in DB
DEFAULT_CURRENT_CHAPTER=0

# Rate limits (Gemini free tier = 15 RPM, 1M TPM, 1500 RPD on flash)
GEMINI_RPM_LIMIT=15
GEMINI_CONCURRENCY=3

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# Browser origins allowed to call the API, comma separated.
# Local dev: http://localhost:3000
# Deployed:  https://YOURNAME.github.io
CORS_ORIGINS=http://localhost:3000

# URL ingestion backend: auto | playwright | http
# "auto" tries a headless browser and falls back to a plain fetch.
# Deployed instances use "http" — no browser, far less memory.
SCRAPER_BACKEND=auto

# Frontend (only used at build time inside Docker or CI)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sub-path the site is served from. GitHub Pages project site: /beyonder
# Root-domain hosts (Cloudflare Pages, Netlify) and local dev: leave empty.
NEXT_PUBLIC_BASE_PATH=
